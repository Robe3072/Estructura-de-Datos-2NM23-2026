import xml.etree.ElementTree as ET

# Clase Cliente
class Cliente:
    def __init__(self, nombre, edad, prioridad):
        self.nombre = nombre
        self.edad = int(edad)
        self.prioridad = prioridad

    def __str__(self):
        return f"{self.nombre}, {self.edad} años, PRIORIDAD: {self.prioridad}"

# Clase ArregloClientes
class ArregloClientes:
    def __init__(self):
        self.lista = []

    def agregar_cliente(self, cliente):
        self.lista.append(cliente)

    def obtener_todos(self):
        return self.lista

# Clase Cola (ADT)
class Cola:
    def __init__(self):
        self.elementos = []

    def encolar(self, cliente):
        self.elementos.append(cliente)

    def esta_vacia(self):
        return len(self.elementos) == 0

    def mostrar(self):
        for c in self.elementos:
            print(c)

    def obtener_todos(self):
        return self.elementos

# Función para cargar clientes desde un archivo XML
def cargar_clientes_de_xml(ruta_entrada):
    arreglo = ArregloClientes()
    try:
        arbol = ET.parse(ruta_entrada)
        raiz = arbol.getroot()

        for elem_cliente in raiz.findall('Cliente'):
            nombre = elem_cliente.find('Nombre').text
            edad = elem_cliente.find('Edad').text
            prioridad = elem_cliente.find('Prioridad').text
            cliente = Cliente(nombre, edad, prioridad)
            arreglo.agregar_cliente(cliente)

        print(f"Clientes cargados desde {ruta_entrada}")
    except FileNotFoundError:
        print("Archivo no encontrado.")
    return arreglo

# Procesar clientes con prioridad ALTA
def procesar_prioridad_alta(arreglo_clientes):
    cola = Cola()
    for cliente in arreglo_clientes.obtener_todos():
        if cliente.prioridad.upper() == "ALTA":
            cola.encolar(cliente)
    return cola

# Mostrar todos los clientes
def mostrar_clientes(arreglo):
    clientes = arreglo.obtener_todos()
    if not clientes:
        print("No hay clientes cargados.")
    else:
        print("\n--- LISTA DE CLIENTES ---")
        for cliente in clientes:
            print(cliente)

# Mostrar clientes con prioridad alta
def mostrar_prioridad_alta(cola):
    if cola.esta_vacia():
        print("No hay clientes con prioridad ALTA.")
    else:
        print("\n--- CLIENTES CON PRIORIDAD ALTA ---")
        cola.mostrar()

# Menú principal
def menu_lectura_xml():
    arreglo = ArregloClientes()
    cola_prioridad = Cola()

    while True:
        print("\n--- MENÚ DE LECTURA DE CLIENTES ---")
        print("1. Cargar clientes desde archivo XML")
        print("2. Mostrar todos los clientes")
        print("3. Mostrar solo clientes con prioridad ALTA")
        print("4. Salir")

        opcion = input("Selecciona una opción: ")

        if opcion == '1':
            ruta = input("Nombre del archivo XML (ej: clientes.xml): ")
            arreglo = cargar_clientes_de_xml(ruta)
            cola_prioridad = procesar_prioridad_alta(arreglo)

        elif opcion == '2':
            mostrar_clientes(arreglo)

        elif opcion == '3':
            mostrar_prioridad_alta(cola_prioridad)

        elif opcion == '4':
            print("Saliendo del programa.")
            break

        else:
            print("Opción no válida. Intenta de nuevo.")

# Ejecutar menú
menu_lectura_xml()
